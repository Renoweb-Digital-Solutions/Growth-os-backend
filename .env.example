# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/growthos

# JWT Authentication
JWT_SECRET=your_jwt_secret_here

# Meta App Integration Configuration (Phase 1)
